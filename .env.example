# DeepEquity — Agentic Company Research System
# Repository: company-research-agent; Python package: research_agent
# Configure accounts and keys yourself. Importing the package never loads .env.

DEEP_EQUITY_MODEL=anthropic:claude-sonnet-4-5-20250929
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# Fill in an application name and your contact email for SEC public-data access.
SEC_USER_AGENT=

# Optional external tracing; keep disabled for offline work.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepequity-dev

# Application steps and HTTP attempts; this is not a hard monetary cost ceiling.
DEEP_EQUITY_MAX_REQUESTS=30
DEEP_EQUITY_MAX_TOOL_CALLS=50
DEEP_EQUITY_MAX_MODEL_CALLS=30
# Maximum output per model step; one truncation repair may double it (cap 32768).
# This is a ceiling, not a target length or a monetary budget.
DEEP_EQUITY_MAX_OUTPUT_TOKENS=8192
# Model transport timeout, separate from the 20-second web-fetch timeout.
# Application model requests also cap this by remaining run time. No timeout retry.
DEEP_EQUITY_MODEL_TIMEOUT_SECONDS=120
DEEP_EQUITY_DEADLINE_SECONDS=300
